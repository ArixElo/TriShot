    <string name="media_title">Allow photo access</string>
    <string name="media_body">Android saves the screenshots itself. TriShot needs access to your photos to show them here and add up their size. Choose \"Allow all\".</string>
    <string name="ready_title">Ready to capture</string>
    <string name="ready_shizuku">Swipe down with three fingers in any app.</string>
