    <!-- Dialogs -->
    <string name="setup_title">Turn on screenshot capture</string>
    <string name="setup_body">TriShot uses an accessibility service only to take screenshots when you ask it to. It doesn\'t read what\'s on your screen.\n\nIn Settings, open \"TriShot capture\" and switch it on.\n\nIf the switch is greyed out (\"Restricted setting\"), open App info, tap ⋮ and choose \"Allow restricted settings\" first.</string>

